{
  "schema_version": 1,
  "ladder_id": "english-coach-difficulty-ladders",
  "ladder_version": "1.0.0",
  "status": "project_operationalization",
  "invariants": {
    "formal_stretch_movement": "exactly one adjacent harder step on one preauthorized dimension",
    "maximum_dimensions_per_binding": 2,
    "maximum_probe_candidates_per_lesson": 1,
    "change_competency_or_activity_family_requires_new_binding": true,
    "support_is_not_a_difficulty_dimension": true,
    "quality_scores_are_not_difficulty_dimensions": true,
    "time_or_cycle_count_expires_state": false,
    "shared_load_axis_hold_cannot_be_bypassed": true
  },
  "excluded_as_dimensions": [
    "accuracy",
    "grammatical_accuracy",
    "vocabulary_control",
    "coherence",
    "fluency",
    "user_mood",
    "CEFR_level",
    "model_latency"
  ],
