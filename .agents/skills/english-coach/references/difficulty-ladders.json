  "modality_adapters": {
    "audio": {
      "metadata": [
        "duration_seconds",
        "speech_rate_band",
        "speaker_count",
        "replay_limit"
      ],
      "rule": "Adapter metadata may validate comparability but cannot create an extra ladder dimension."
    },
    "text": {
      "metadata": [
        "word_count",
        "layout_navigation",
        "genre"
      ],
      "rule": "Word count must fit the selected span step; navigation changes outside tolerance make evidence non-comparable."
    },
    "speech": {
      "metadata": [
        "response_time_target",
        "preparation_seconds",
        "interaction_participants"
      ],
      "rule": "Asynchronous message delay is never a cost or fluency signal."
    },
    "writing": {
      "metadata": [
        "word_target",
        "genre",
        "audience",
        "reference_access"
      ],
      "rule": "Genre or communicative purpose changes require a new activity contract, not a hidden harder step."
    }
  },
  "movement_policy": {
    "target_check": "all active dimensions remain at the frozen target steps",
    "difficulty_probe": "one preauthorized dimension moves exactly one ordinal higher; every other condition remains within adapter tolerance",
    "scaffolded": "may select a predefined easier step or instructional support, but does not lower the stored target",
    "ceiling": "the highest step sets ceiling_reached for this binding only",
    "invalid_or_non_comparable": "does not move target, counters, hold, or queue"
  },
  "evidence_mode_compatibility": {
    "training": [
      "practice",
      "transfer"
    ],
    "target_check": [
      "probe",
      "transfer"
    ],
    "difficulty_probe": [
      "probe"
    ],
    "capability_probe": [
      "assessment"
    ],
    "rules": [
      "practice cannot become difficulty_probe",
      "capability_probe never updates adaptation state",
      "review and guided answers never update adaptation state"
    ]
  },
  "adaptation_policy": {
    "progress_state": [
      "target_building",
      "probe_ready",
      "confirmation_building",
      "promotion_hold"
    ],
    "overlays": [
      "target_unstable"
    ],
    "learning_flags": [
      "user_hold",
      "ceiling_reached"
    ],
    "migration_flag": [
      "migration_review_required"
    ],
    "hold_phase": [
      "recovering",
      "release_ready",
      "first_probe_met",
      "confirmation_ready"
    ],
    "probe_ready": {
      "successes": 2,
      "different_study_days": 2,
      "different_contexts": 2,
      "normal_cost_requirement": "If the latest success is high or unknown, require one later normal target success.",
      "scheduling": "eligible only for a later compatible activity preauthorized at cycle review"
    },
    "promotion": {
      "sequence": [
        "stretch_met on a new day/context",
        "later target success",
        "later stretch_met on a new day/context"
      ],
      "normal_cost_requirement": "At least one stretch_met has cost_signal normal.",
      "result": "move target one adjacent step, return to target_building, and require later consolidation"
    },
